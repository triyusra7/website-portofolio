%% 2. USER FLOW — SALES INVOICE TO AUTOMATIC JOURNAL
%% ------------------------------------------------------------
flowchart LR
  A["Pilih customer<br/><i>limit kredit tampil</i>"] --> B["Isi item & qty<br/><i>harga incl. PPN, DPP dihitung mundur</i>"]
  B --> C["Cek total<br/><i>DPP · PPN · Grand total</i>"]
  C --> D["Post Invoice"]
  D -.->|otomatis| J["Jurnal JRN-INV-xxx<br/>Dr Piutang Usaha 01-007<br/>Cr Penjualan 04-001<br/>Cr PPN Keluaran 02-003"]
  J --> AR["Piutang Dagang + aging"]
  J --> GL["Buku Besar"]
  D --> SJ["Surat Jalan"] -.->|otomatis| HPP["Jurnal HPP<br/>Dr HPP · Cr Persediaan"]
  HPP --> KS["Kartu Stok"]
  GL --> LR["Laba Rugi"]
  GL --> NR["Neraca"]
  GL --> AK["Arus Kas"]
  GL --> KST["Key Stats"]
  GL --> KON["Laporan Konsolidasi"]


