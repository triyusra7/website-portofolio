%% ------------------------------------------------------------
%% 1. INFORMATION ARCHITECTURE
%% ------------------------------------------------------------
flowchart TB
  L["Login<br/>username / e-mail + password"] --> R["Role & menu permissions<br/>Admin · Manager · Staff"]
  R --> SW{{"Entity switcher (top bar)"}}

  SW --> C1["PT. Tangkian Lintas Anugerah<br/><i>Cement distribution</i>"]
  SW --> C2["PT. Tangkian Samudera Logistik<br/><i>Stevedoring & haulage (PBM)</i>"]
  SW --> C3["Arobi<br/><i>Coffee shop</i>"]

  subgraph E1[" "]
    C1 --> C1a["Penjualan<br/>Invoice · Surat Jalan · Piutang Dagang"]
    C1 --> C1b["Pembelian<br/>Purchase Order · Penerimaan Barang · Hutang Dagang"]
    C1 --> C1c["Persediaan<br/>Kartu Stok · Stock Adjustment · Master Gudang"]
    C1 --> C1d["Laporan operasional<br/>Penjualan · PO · Surat Jalan · Kartu Piutang"]
  end

  subgraph E2[" "]
    C2 --> C2a["PBM & Ekspedisi<br/>Job Order · Invoice PBM/Dooring · Piutang Usaha"]
    C2 --> C2b["Pembelian<br/>PO vendor · Vendor/Subkon · Hutang Usaha"]
    C2 --> C2c["Laporan operasional<br/>Pendapatan · PO · Kartu Piutang/Hutang"]
  end

  subgraph E3[" "]
    C3 --> C3a["Penjualan<br/>Invoice tunai/kredit · Piutang Usaha"]
    C3 --> C3b["Pembelian<br/>PO bahan baku · Penerimaan · Hutang Usaha"]
    C3 --> C3c["Master<br/>Produk/Menu · Supplier"]
  end

  E1 --> CORE
  E2 --> CORE
  E3 --> CORE

  CORE["Accounting core (identical per entity)<br/>Jurnal · Buku Besar · Neraca Saldo · Laba Rugi · Neraca · Arus Kas · Key Stats"]
  CORE --> SETUP["Setup<br/>Chart of Accounts · Master Kas & Bank · Saldo Awal · Periode Akuntansi · Profil · Pengguna · Hak Akses"]
  CORE --> KONS["Laporan Konsolidasi (group level)<br/>Laba Rugi Konsolidasi · Neraca Konsolidasi · Ringkasan Entitas"]


